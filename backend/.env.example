# Copy to `.env` for local development, or set these as real environment variables on whatever
# host runs this in production (Render/Railway/etc. -- see docs/deploying.md). Never commit a
# real .env file; it's already gitignored.

# Local dev fallback: sqlite:///./dev.db (see README.md's Database section).
# Production: a real PostgreSQL connection string, e.g.
#   postgresql+psycopg2://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./dev.db

# Must be a real random secret in production -- app/config.py refuses to start otherwise
# once APP_ENV=production. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=dev-secret-change-me

# development | production. Only "production" enforces the JWT_SECRET check above.
APP_ENV=development

# Comma-separated list of frontend origins allowed to call this API (CORS). Defaults to the
# local Vite dev server if unset.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
